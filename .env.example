# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for charting. Sonnet is a good default; switch to opus for higher quality.
CHART_MODEL=claude-sonnet-4-6

# --- Whisper (local, runs on this machine) ---
# Backend: mlx (Apple Silicon, ~15-25x realtime), ctranslate2 (any CPU, ~3x realtime),
# or auto (default — picks mlx on Apple Silicon, ctranslate2 elsewhere).
WHISPER_BACKEND=auto
# For mlx, this is a HuggingFace repo (try mlx-community/whisper-large-v3-mlx).
# For ctranslate2, this is a model size name: tiny | base | small | medium | large-v3.
# Recommended on Apple Silicon: mlx-community/whisper-large-v3-mlx
# Recommended on Intel CPU:     medium
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# CTranslate2 only — int8 is fastest on CPU; float16 needs a GPU.
WHISPER_COMPUTE=int8
# CTranslate2 only — 0 = auto-detect.
WHISPER_THREADS=0

# --- Email (SMTP) ---
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# NOT your regular Gmail password. Requires 2FA enabled on the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your.email@gmail.com
# Default recipient (sister's email). Can be overridden per-upload in the UI.
DEFAULT_RECIPIENT=her.email@example.com

# --- App ---
# Where to listen. Keep on localhost for privacy.
HOST=127.0.0.1
PORT=8000
# If true, audio + transcript files on disk are deleted after the email is sent.
PURGE_AFTER_SEND=true
